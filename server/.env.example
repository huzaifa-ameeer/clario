# Server port (Render provides PORT automatically)
PORT=8000

# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173,https://your-frontend.vercel.app

# MongoDB connection string
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/clarious

# Auth
JWT_SECRET=your-strong-random-secret

# Resend (OTP emails)
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=Clarious <onboarding@resend.dev>

# Gemini AI
GEMINI_API_KEY=AIzaxxxxxxxxxxxx
# Optional: override fallback model list (comma-separated)
# GEMINI_MODELS=gemini-3.8-flash,gemini-3.7-flash

# production disables non-https cookies
NODE_ENV=production
